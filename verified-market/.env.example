# Leave everything blank to run fully in mock mode (no keys, works offline).

# Capital One Nessie — get a key at http://api.nessieisreal.com
NESSIE_KEY=
NESSIE_MOCK=1          # set to 0 once NESSIE_KEY is filled in

# Persona — from your sandbox dashboard (https://withpersona.com)
PERSONA_API_KEY=       # server-side secret; leave blank for mock verification
PERSONA_TEMPLATE_ID=   # public, e.g. itmpl_xxx
PERSONA_ENV_ID=        # public, e.g. env_xxx (sandbox)

SECRET_KEY=change-me
CONFIRM_WINDOW_SECONDS=86400
