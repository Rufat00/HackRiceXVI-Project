# Copy to .env and `set -a; source .env; set +a` (or use python-dotenv). All optional.
SECRET_KEY=change-me

# Capital One Nessie — leave blank to run on the built-in mock ledger
NESSIE_API_KEY=

# Persona sandbox — leave blank to run the mock pass/fail toggle
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=
PERSONA_ENVIRONMENT_ID=
PERSONA_WEBHOOK_SECRET=

# Escrow timers in seconds. Short values make auto-refund/auto-release visible during a demo.
HANDOFF_DEADLINE_SECONDS=259200
CONFIRM_WINDOW_SECONDS=86400

# Comma-separated admin emails. If empty, the first account registered becomes admin.
ADMIN_EMAILS=
