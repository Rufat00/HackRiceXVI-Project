SECRET_KEY=change-me
# Public URL guests reach (goes in the QR). Use ngrok for phones on another network.
PUBLIC_URL=

# Browser playback + public music search. Enable YouTube Data API v3 in Google Cloud.
YOUTUBE_API_KEY=
YOUTUBE_REGION_CODE=US

# Spotify (host controls playback). Register redirect URI exactly: http://127.0.0.1:5000/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: Claude for theme interpretation + DJ shoutouts
ANTHROPIC_API_KEY=

# Demo: make mock songs fly by (30 = a 3-minute song lasts 6 seconds)
MOCK_TIME_SCALE=1
